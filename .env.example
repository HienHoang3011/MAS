# App
ENV=dev
LOG_LEVEL=INFO

# LLM
LLM_PROVIDER=proxy
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# For Gemini: set LLM_PROVIDER=gemini and provide GEMINI_API_KEY.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash
AGENT_MAX_CLARIFICATIONS=3
AGENT_MAX_EXECUTIONS=2
LLM_BASE_URL=http://127.0.0.1:8080/v1
LLM_MODEL=Qwen/Qwen3.5-35B-A3B-GPTQ-Int4
LLM_API_KEY=
LLM_TIMEOUT=120

# Database
# DATABASE_URL=postgres+psycopg://user:pass@localhost:5432/mydb
MONGODB_URI=
MONGODB_DATABASE=mas
MONGODB_KNOWLEDGE_DATABASE=data
MONGODB_KNOWLEDGE_COLLECTION=gtrinh
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_CACHE_DIR=.cache/models
SUMMARY_POLL_SECONDS=5
