# App
ENV=dev
LOG_LEVEL=INFO

# LLM
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# For Gemini: set LLM_PROVIDER=gemini and provide GEMINI_API_KEY.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash
AGENT_MAX_CLARIFICATIONS=3
AGENT_MAX_EXECUTIONS=2

# Database
# DATABASE_URL=postgres+psycopg://user:pass@localhost:5432/mydb
